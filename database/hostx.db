-- 1. সব পুরানো অ্যাডমিন ডিলিট করুনDELETE FROM users WHERE role = 'super_admin' OR is_admin = 1 OR is_super_admin = 1;-- 2. আপনার নতুন অ্যাডমিন অ্যাকাউন্ট তৈরি করুনINSERT INTO users (    full_name,    username,     email,     password_hash,     coins,     role,     status,     is_admin,     is_super_admin,     admin_permissions,    created_at) VALUES (    'Onik Islam',    'admin',    'onikislam3455@gmail.com',    'pbkdf2:sha256:260000$8a7f3c9e2b5d1a4f6e8c7d9a0b3f5e2c$9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b7c6d',    1000,    'super_admin',    'active',    1,    1,    'manage_users,manage_coins,manage_files,manage_settings,manage_announcements,manage_broadcasts,view_logs',    CURRENT_TIMESTAMP);-- 3. কনফর্মেশন চেক করুনSELECT id, full_name, username, email, role, is_admin, is_super_admin FROM users WHERE username = 'admin';